geometry_msgs/Point position    # 바운딩박스 중심 (x, y, z) [m]
float32 size_x                  # 바운딩박스 X 크기 [m]
float32 size_y                  # 바운딩박스 Y 크기 [m]
float32 size_z                  # 바운딩박스 Z 크기 (높이) [m]
float32 confidence              # 시그모이드 정규화 신뢰도 (0.0~1.0)
int32 label                     # 클러스터 ID
