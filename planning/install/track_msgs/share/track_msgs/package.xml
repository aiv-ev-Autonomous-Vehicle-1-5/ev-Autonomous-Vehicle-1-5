<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  track_msgs 패키지 메타데이터 (package.xml)

  역할:
    - 로컬 플래너 파이프라인에서 사용하는 커스텀 ROS 2 메시지 정의
    - .msg 파일에서 C++ 헤더 / Python 모듈을 자동 생성

  메시지 목록 (8종):
    - Cone.msg / ConeArray.msg                 : LiDAR 콘 검출 결과
    - LaneBoundary.msg / LaneBoundaryArray.msg : 카메라 차선 경계
    - Obstacle.msg / ObstacleArray.msg         : 장애물 (미사용, 확장용)
    - PlannerStatus.msg                        : 플래너 상태 (OK/STOP/INFEASIBLE/STALE)
    - SystemState.msg                          : 시스템 FSM 상태 (미사용, 확장용)

  빌드 순서:
    - 이 패키지가 track_planning보다 먼저 빌드되어야 함
    - colcon이 depend 관계를 분석하여 자동으로 순서 결정

  rosidl 생성 흐름:
    .msg 파일 → rosidl_default_generators → C++ 헤더 + Python 모듈
    → track_msgs/msg/xxx.hpp (C++)
    → track_msgs.msg.Xxx (Python)
-->
<package format="3">
  <name>track_msgs</name>
  <version>0.1.0</version>
  <description>Custom message definitions for track autonomous driving system</description>
  <maintainer email="jjss4824@gmail.com">aiv</maintainer>
  <license>Apache-2.0</license>

  <!-- 빌드 도구: ROS 2 CMake 빌드 시스템 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 메시지 코드 생성기: .msg → C++/Python 바인딩 (빌드 시에만 필요) -->
  <build_depend>rosidl_default_generators</build_depend>
  <!-- 메시지 런타임: 생성된 코드가 실행 시 참조하는 라이브러리 -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- 메시지에서 참조하는 외부 타입: Point, Pose, Header 등 -->
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <!-- rosidl 인터페이스 패키지 그룹에 등록 (다른 패키지에서 자동 발견 가능) -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- 테스트 도구 -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
