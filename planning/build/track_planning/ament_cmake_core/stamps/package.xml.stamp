<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  track_planning 패키지 메타데이터 (package.xml)

  역할:
    - colcon이 빌드 순서를 결정할 때 이 파일의 의존성 정보를 참조함
    - rosdep이 시스템 의존성을 자동 설치할 때 사용됨
    - ros2 pkg list, ros2 pkg xml 등에서 패키지 정보 조회 시 사용됨

  의존성 구분:
    - buildtool_depend : 빌드 도구 (ament_cmake)
    - depend          : 빌드 + 실행 시 모두 필요한 패키지
    - test_depend     : 테스트 시에만 필요한 패키지

  이 패키지는 track_msgs (커스텀 메시지)에 의존하므로
  track_msgs가 먼저 빌드되어야 함 (colcon이 자동으로 순서 처리)
-->
<package format="3">
  <name>track_planning</name>
  <version>0.1.0</version>
  <description>Local planning pipeline for track autonomous driving</description>
  <maintainer email="jjss4824@gmail.com">aiv</maintainer>
  <license>Apache-2.0</license>

  <!-- 빌드 도구: ROS 2 CMake 빌드 시스템 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 핵심: C++ 클라이언트 라이브러리 (Node, Publisher, Subscription, Timer) -->
  <depend>rclcpp</depend>
  <!-- ComposableNode 등록/로딩 매크로 (RCLCPP_COMPONENTS_REGISTER_NODE) -->
  <depend>rclcpp_components</depend>
  <!-- 내비게이션 메시지: Path (최종 경로 퍼블리시용) -->
  <depend>nav_msgs</depend>
  <!-- 기하학 메시지: Point, PoseStamped (Path 내부 구조) -->
  <depend>geometry_msgs</depend>
  <!-- 표준 메시지: Bool, Header (디버그 퍼블리시용) -->
  <depend>std_msgs</depend>
  <!-- 시각화 메시지: Marker, MarkerArray (RViz2 디버그용, 향후 확장) -->
  <depend>visualization_msgs</depend>
  <!-- 커스텀 메시지: Cone, LaneBoundary, PlannerStatus 등 -->
  <depend>track_msgs</depend>

  <!-- 테스트 도구: lint 자동 검사 -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
