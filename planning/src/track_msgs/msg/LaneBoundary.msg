# =============================================================
# track_msgs/msg/LaneBoundary.msg
# =============================================================
# 단일 차선 경계선 — 순서대로 정렬된 경계점 배열
#
# 용도:
#   - 카메라 기반 차선 인식 결과로 검출된 경계선을 표현
#   - CorridorBuilder에서 좌/우 경계 체이닝의 입력으로 사용
#   - 콘(Cone)이 없는 구간에서 경계 대체 역할
#
# 좌/우 구분:
#   - side == LEFT (0)  : 좌측 차선 경계
#   - side == RIGHT (1) : 우측 차선 경계
#   - parse_lanes()에서 side 필드 기반으로 lane_left / lane_right 분리
#
# 대회 규격:
#   - 차선: 10cm 흰색 테이프, 5cm 검은색 경계선
#   - 차로 폭: 1.5m
# =============================================================

std_msgs/Header header              # 타임스탬프 + 좌표계 프레임 (base_link)
geometry_msgs/Point[] points        # 순서 정렬된 경계점 배열 [m] — 차량에서 가까운 점부터

# 좌/우 상수 및 필드
uint8 LEFT  = 0                     # 좌측 차선 경계 상수
uint8 RIGHT = 1                     # 우측 차선 경계 상수
uint8 side                          # 이 경계의 좌/우 구분 (LEFT 또는 RIGHT)

float32 confidence                  # 검출 신뢰도 (0.0 ~ 1.0) — 향후 가중치 적용 가능
